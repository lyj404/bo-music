# 仓库内统一存 LF，检出时按平台转换。与全局 core.autocrlf=true 配合即可，
# 显式写出来是为了换机器时行为一致。
* text=auto

*.rs       text
*.toml     text
*.md       text
*.json     text

# cmd 的批处理文件同理：检出时必须是 CRLF
*.bat      text eol=crlf

# 二进制
*.apk      binary
*.dll      binary
*.png      binary
*.jpg      binary
*.ico      binary

# 音频资源按二进制处理，避免换行规范化
*.ogg      binary
*.flac     binary
